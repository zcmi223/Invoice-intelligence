# Copy to .env and fill in. Demo mode (no key) works out of the box.
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Your workspace slug, e.g. "acme-finance". Find it at app.roboflow.com > settings.
ROBOFLOW_WORKSPACE=
# The workflow to run, e.g. "invoice-extraction" (the URL slug, not the doc ID).
ROBOFLOW_WORKFLOW_ID=invoice-extraction
